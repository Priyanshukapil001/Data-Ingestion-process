						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat(\n    'SELECT COUNT(1) AS FileCount FROM dbo.transactions WHERE ImportFileName = ''',\n    activity('Get transactionFileName').output.childItems[0].name,\n    ''''\n)",
